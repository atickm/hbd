<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Happy Birthday</title>

<style>
body{
    margin:0;
    background:#000;
    overflow:hidden;
}
canvas{
    display:block;
}
</style>
</head>
<body>

<canvas id="c"></canvas>

<script>
const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d");

function resizeAndDraw() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    createParticles();
}

let particles = [];
let phase = "float";

// CREATE PARTICLES BASED ON SCREEN SIZE
function createParticles() {
    const w = canvas.width;
    const h = canvas.height;
    
    // TEXT CANVAS
    const tCanvas = document.createElement("canvas");
    const tCtx = tCanvas.getContext("2d");
    
    tCanvas.width = w;
    tCanvas.height = h;
    
    tCtx.fillStyle = "red";
    tCtx.textAlign = "center";
    tCtx.textBaseline = "middle";
    
    // RESPONSIVE FONT SIZE - BIGGER ON PHONES
    let fontSize;
    if (w < 600) {
        // Phone
        fontSize = Math.min(w / 6, 59);
    } else {
        // Desktop
        fontSize = Math.min(w / 12, 110);
    }
    
    tCtx.font = `bold ${fontSize}px "Segoe UI", "Poppins", "Arial", system-ui`;
    
    // MULTI-LINE TEXT WITH SPACING
    const line1 = "শুভ জন্মদিন";
    const line2 = "বৈশাখী";
    
    const lineHeight = fontSize * 1.5;
    const centerY = h / 2;
    
    tCtx.fillText(line1, w / 2, centerY - lineHeight / 2);
    tCtx.fillText(line2, w / 2, centerY + lineHeight / 2);
    
    const data = tCtx.getImageData(0, 0, w, h).data;
    
    particles = [];
    const step = 7;
    
    for(let y = 0; y < h; y += step){
        for(let x = 0; x < w; x += step){
            let i = (y * w + x) * 4;
            if(data[i + 3] > 150){
                particles.push({
                    x: Math.random() * w,
                    y: Math.random() * h,
                    tx: x,
                    ty: y,
                    vx: (Math.random() - 0.5) * 2,
                    vy: (Math.random() - 0.5) * 2,
                    size: 2
                });
            }
        }
    }
}

// HEART
function heart(x, y, s){
    ctx.fillStyle = "#ff69b4";  // Hot pink - brighter than purple
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.bezierCurveTo(x - s, y - s, x - 2 * s, y + s, x, y + 2 * s);
    ctx.bezierCurveTo(x + 2 * s, y + s, x + s, y - s, x, y);
    ctx.fill();
}

// RESET ANIMATION ON RESIZE
let resizeTimeout;
window.addEventListener("resize", () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
        resizeAndDraw();
        phase = "float";
    }, 200);
});

// INITIALIZE
resizeAndDraw();

// SWITCH TO FORM AFTER TIME
setTimeout(() => {
    phase = "form";
}, 4000);

// ANIMATION
function animate(){
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    particles.forEach(p => {
        if(phase === "float"){
            p.x += p.vx;
            p.y += p.vy;
            
            if(p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if(p.y < 0 || p.y > canvas.height) p.vy *= -1;
        }
        else{
            p.x += (p.tx - p.x) * 0.04;
            p.y += (p.ty - p.y) * 0.04;
        }
        
        heart(p.x, p.y, p.size);
    });
    
    requestAnimationFrame(animate);
}

animate();
</script>

</body>
</html>
